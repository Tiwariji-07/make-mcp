# Canonical public site origin (metadata, Open Graph, sitemap, robots).
# Set this to your production domain after DNS/custom domain is live.
NEXT_PUBLIC_SITE_URL=https://make-mcp.vercel.app

# --- Server-side process verification (OFF by default on the public API) ---
# Never enable these on a public multi-tenant deployment unless you accept
# CPU/disk cost and have shared rate limiting in place.

# Allow "fast" verification (writes temp project + runs tsc) and "full" mode
# when combined with MCPMINT_ALLOW_FULL_VERIFY. Public generate/preview strips
# verification unless this is "1".
# MCPMINT_ALLOW_PROCESS_VERIFY=1

# Allow verificationMode=full (npm install / pip + build). Implies process
# verify is allowed. Leave unset/0 in production public hosting.
# MCPMINT_ALLOW_FULL_VERIFY=1

# Timeout (ms) for each spawned verification command. Default 120000.
# MCPMINT_FULL_VERIFY_TIMEOUT_MS=120000

# --- Rate limiting ---
# Max requests per IP per 60s window for /api/generate and /api/fetch-spec.
# Default 20.
# MCPMINT_RATE_LIMIT_MAX=20

# Trust client-supplied x-real-ip for rate-limit keys. Default off — only enable
# behind a reverse proxy that overwrites this header (not needed on Vercel).
# MCPMINT_TRUST_X_REAL_IP=1

# Optional shared rate limiter (recommended on Vercel). When both are set,
# counters live in Upstash Redis instead of per-instance memory.
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=
