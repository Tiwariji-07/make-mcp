{
  "swagger": "2.0",
  "info": {
    "title": "Legacy Pets API",
    "version": "1.0.0"
  },
  "schemes": [
    "https"
  ],
  "host": "legacy-pets.acme.test",
  "basePath": "/api",
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/pets": {
      "post": {
        "operationId": "createPet",
        "summary": "Create pet",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "description": "Pet payload.",
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "age": {
                  "type": "integer"
                }
              },
              "required": [
                "name"
              ]
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Pet created",
            "schema": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
