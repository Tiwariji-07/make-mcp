{
  "openapi": "3.0.3",
  "info": {
    "title": "Uploads API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://uploads.acme.test"
    }
  ],
  "paths": {
    "/assets": {
      "post": {
        "operationId": "uploadAsset",
        "summary": "Upload an asset",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "The file to upload."
                  },
                  "metadata": {
                    "type": "object",
                    "properties": {
                      "title": {
                        "type": "string"
                      },
                      "tags": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "required": [
                  "file"
                ]
              },
              "encoding": {
                "metadata": {
                  "contentType": "application/json"
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Asset uploaded"
          }
        }
      }
    }
  }
}
