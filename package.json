{
  "name": "mcpmint-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:generator": "npm run test:generator:unit && npm run test:parsers && npm run test:api",
    "test:generator:unit": "node --test --experimental-strip-types --experimental-specifier-resolution=node src/lib/generator/*.test.ts",
    "test:parsers": "node --test --experimental-strip-types --experimental-specifier-resolution=node src/lib/parsers/*.test.ts",
    "test:api": "node --test --experimental-strip-types --experimental-specifier-resolution=node src/lib/api/*.test.ts",
    "test:workflow": "node --test --experimental-strip-types next-config.test.ts src/app/accessibility-contract.test.ts src/store/project-history.test.ts src/lib/scanner/*.test.ts src/lib/scanner/checks/*.test.ts",
    "test:cli": "node --test --experimental-strip-types cli/src/*.test.ts",
    "test:generated:full": "node --test --experimental-strip-types --experimental-specifier-resolution=node src/lib/generator/generated-full-verification.ci.ts",
    "audit:dependencies": "npm audit --audit-level=low"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@vercel/analytics": "^1.6.1",
    "archiver": "^8.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^0.562.0",
    "next": "^16.2.10",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-dropzone": "^14.3.8",
    "tailwind-merge": "^3.4.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/archiver": "^8.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.10",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "overrides": {
    "js-yaml": "4.3.0",
    "@apidevtools/swagger-parser": {
      "ajv": "8.20.0",
      "fast-uri": "4.1.1"
    },
    "next": {
      "postcss": "8.5.20"
    }
  }
}
